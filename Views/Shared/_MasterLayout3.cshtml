@using Microsoft.AspNet.Identity
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Shopdunk</title>

    <link href="~/Content/ShopdunkLayout.css" rel="stylesheet" />
    <link href="~/Content/stylepro.css" rel="stylesheet" />
    <link href="~/Content/style-form.css" rel="stylesheet" />
    <link href="~/Content/style-cart.css" rel="stylesheet" />
    <link href="~/Content/style-detail.css" rel="stylesheet" />
    <link href="~/Content/style-admin.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

@{
    bool isUserAdmin = User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<body class="@(isUserAdmin ? "admin-theme" : "")">

    <header class="main-header">
        <div class="logo">
            <a href="@Url.Action("Trangchu", "Home")">
                <img src="https://shopdunk.com/images/thumbs/0012445_Logo_ShopDunk.png" alt="Logo" style="height: 40px;">
            </a>
        </div>
        <div class="search-bar">
            @using (Html.BeginForm("Search", "Home", FormMethod.Get, new { @class = "search-form" }))
            {
                <input type="text" name="query" placeholder="Bạn tìm gì..." value="@ViewBag.SearchQuery" autocomplete="off">
                <button type="submit" class="search-button"><i class="fa-solid fa-magnifying-glass"></i></button>
            }
        </div>
    </header>

    <div class="header-actions">
        <a href="@Url.Action("GioHang", "Home")" class="action-item">
            <i class="fa-solid fa-shopping-cart"></i> <span>Giỏ hàng</span>
        </a>
        @Html.Partial("_LoginPartial")
    </div>

    <nav class="main-nav">
        <ul>
            <li><a href="@Url.Action("Trangchu", "Home")">iPhone</a></li>
            <li><a href="#">iPad</a></li>
            <li><a href="#">Mac</a></li>
            <li><a href="#">Watch</a></li>
            <li><a href="#">Phụ kiện</a></li>
            <li><a href="#">Âm thanh</a></li>
        </ul>
    </nav>

    <div class="site-content">
        <main class="container">
            @RenderBody()
        </main>
    </div>
    <footer class="main-footer">
        <p>&copy; @DateTime.Now.Year - My E-commerce Website</p>
    </footer>

</body>
</html>