@model IEnumerable<DemoWeb1.Models.Product>

@{
    ViewBag.Title = "Thống kê Tồn kho";
    Layout = "~/Views/Shared/_MasterLayout3.cshtml"; 
}

<style>
    .stock-container {
        padding: 30px;
        background-color: #3a3a3a;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        max-width: 1000px;
        margin: 30px auto;
        color: #e0e0e0;
    }

        .stock-container h2 {
            color: #ffffff;
            margin-bottom: 25px;
            border-bottom: 2px solid #555;
            padding-bottom: 15px;
            text-align: center;
        }

    .table-dark-theme {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table-dark-theme th,
        .table-dark-theme td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #555;
            color: #e0e0e0;
        }

        .table-dark-theme th {
            background-color: #1a1a1a;
            color: #ffffff;
            font-weight: bold;
        }

        .table-dark-theme tr:nth-child(even) {
            background-color: #424242;
        }

        .table-dark-theme tr:hover {
            background-color: #555;
        }

    /* CSS cho các nhãn trạng thái */
    .status-label {
        padding: 5px 10px;
        border-radius: 4px;
        color: #fff;
        font-weight: bold;
    }

    .status-in-stock {
        background-color: #28a745;
    }
    /* Xanh lá */
    .status-low-stock {
        background-color: #ffc107;
        color: #000;
    }
    /* Vàng */
    .status-out-of-stock {
        background-color: #dc3545;
    }
    /* Đỏ */

</style>

<div class="stock-container">
    <h2>Thống kê Hàng tồn kho</h2>
    <p style="text-align: center;">Danh sách sản phẩm được sắp xếp theo số lượng tồn kho (thấp đến cao).</p>

    <table class="table table-dark-theme">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Số lượng tồn</th>
                <th>Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NamePro)</td>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.SoLuongTon)</strong>
                    </td>
                    <td>
                        @if (item.SoLuongTon == 0)
                        {
                            <span class="status-label status-out-of-stock">Hết hàng</span>
                        }
                        else if (item.SoLuongTon <= 10)
                        {
                            <span class="status-label status-low-stock">Sắp hết hàng</span>
                        }
                        else
                        {
                            <span class="status-label status-in-stock">Còn hàng</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>