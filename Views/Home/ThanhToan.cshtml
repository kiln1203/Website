@model List<DemoWeb1.Models.CartItem>
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_MasterLayout3.cshtml";
}

<link href="~/Content/style-form.css" rel="stylesheet" />
<link href="~/Content/style-cart.css" rel="stylesheet" />

<div class="cart-container">
    <h2 style="margin-bottom: 30px;">Thanh toán đơn hàng</h2>

    <div class="cart-layout">

        <div class="checkout-form-container">
            <h3>Thông tin giao hàng</h3>

            @using (Html.BeginForm("XuLyThanhToan", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="CustomerName">Họ và tên người nhận:</label>
                    <input type="text" id="CustomerName" name="CustomerName" placeholder="Nhập họ tên..." required />
                </div>

                <div class="form-group">
                    <label for="CustomerPhone">Số điện thoại:</label>
                    <input type="tel" id="CustomerPhone" name="CustomerPhone" placeholder="Nhập số điện thoại..." required />
                </div>

                <div class="form-group">
                    <label for="CustomerAddress">Địa chỉ giao hàng:</label>
                    <input type="text" id="CustomerAddress" name="CustomerAddress" placeholder="Nhập địa chỉ (số nhà, tên đường...)" required />
                </div>

                <div class="form-group">
                    <label for="PaymentMethod">Phương thức thanh toán:</label>
                    <select id="PaymentMethod" name="PaymentMethod" class="form-control">
                        <option value="COD" selected>Thanh toán khi nhận hàng (COD)</option>
                        <option value="Bank">Chuyển khoản ngân hàng</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-checkout" style="width: 100%; margin-top: 20px;">
                    Hoàn tất đặt hàng
                </button>
            }
        </div>

        <div class="cart-summary">
            <h3>Tóm tắt đơn hàng</h3>

            <div class="checkout-summary-items">
                @foreach (var item in Model)
                {
                    <div class="summary-item">
                        <img src="~/Images/@item.Image" class="summary-item-image" />
                        <div class="summary-item-info">
                            <span class="summary-item-name">@item.NamePro</span>
                            <span class="summary-item-quantity">SL: @item.Quantity</span>
                        </div>
                        <span class="summary-item-price">@item.TotalPrice.ToString("N0")₫</span>
                    </div>
                }
            </div>

            <div class="summary-row total">
                <span>Tổng cộng:</span>
                <span class="summary-value total-price">@ViewBag.TongTien.ToString("N0")₫</span>
            </div>
        </div>

    </div>
</div>